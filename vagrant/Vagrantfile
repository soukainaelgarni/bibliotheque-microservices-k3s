# frozen_string_literal: true

# Phase 3 - Infrastructure as Code (Vagrant)
# Provisionne un cluster K3s multi-noeuds (master + worker) pour le Projet 4.

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  # --- Machine Master ---
  config.vm.define "master" do |master|
    master.vm.hostname = "projet4-master"
    master.vm.network "private_network", ip: "192.168.56.10"

    # Acces aux services via NodePort K3s (Phase 4)
    master.vm.network "forwarded_port", guest: 30080, host: 8080, id: "catalogue"
    master.vm.network "forwarded_port", guest: 30081, host: 8081, id: "emprunts"
    master.vm.network "forwarded_port", guest: 30082, host: 8087, id: "notifications"
    master.vm.network "forwarded_port", guest: 80, host: 8085, id: "ingress"

    master.vm.provider "virtualbox" do |vb|
      vb.name = "projet4-master"
      vb.memory = 2048
      vb.cpus = 2
    end

    master.vm.synced_folder "..", "/opt/projet4", create: true

    master.vm.provision "shell", name: "base", path: "scripts/provision-base.sh"
    master.vm.provision "shell", name: "docker", path: "scripts/provision-docker.sh"
    master.vm.provision "shell", name: "k3s-master", path: "scripts/provision-k3s-master.sh"
  end

  # --- Machine Worker ---
  config.vm.define "worker" do |worker|
    worker.vm.hostname = "projet4-worker"
    worker.vm.network "private_network", ip: "192.168.56.11"

    worker.vm.provider "virtualbox" do |vb|
      vb.name = "projet4-worker"
      vb.memory = 1536
      vb.cpus = 1
    end

    worker.vm.synced_folder "..", "/opt/projet4", create: true

    worker.vm.provision "shell", name: "base", path: "scripts/provision-base.sh"
    worker.vm.provision "shell", name: "docker", path: "scripts/provision-docker.sh"
    worker.vm.provision "shell", name: "k3s-worker", path: "scripts/provision-k3s-worker.sh"
  end
end